<Entity tags="projectile_player,no_enemy_perks,polymorphable_NOT" name="$projectile_default">
  	<Base file="data/entities/base_projectile.xml"></Base>

	<Base file="data/entities/animals/longleg.xml">
		<!-- <CameraBoundComponent _enabled="0"/> -->
		<InteractableComponent _remove_from_base="1"></InteractableComponent>
		<LuaComponent _remove_from_base="1"></LuaComponent>
	</Base>

	<ProjectileComponent
		_enabled="1"
		lob_min="0.9"
		lob_max="1.0"
		speed_min="250"
		speed_max="280"
		friction="0.6"
		direction_random_rad="0.05"
		on_death_explode="0"
		on_death_gfx_leave_sprite="0" 
		on_lifetime_out_explode="0"
		explosion_dont_damage_shooter="0" 
		on_collision_die="0"
		lifetime="-1"
		damage="0"
		velocity_sets_scale="0"
		velocity_updates_animation="0.5"
		velocity_sets_rotation="0"
		lifetime_randomness="0"
		ragdoll_force_multiplier="0.04"
		hit_particle_force_multiplier="5.5"
		camera_shake_when_shot="5.0"
		shoot_light_flash_radius="0"
		shoot_light_flash_r="255"
		shoot_light_flash_g="240"
		shoot_light_flash_b="30"
		damage_every_x_frames="15"
	></ProjectileComponent>

	<VariableStorageComponent
		name="projectile_file"
		value_string="mods/noita.hardmod/files/modules/bosses/entity/projectile/summon_hamis.xml"
	></VariableStorageComponent>
</Entity>
